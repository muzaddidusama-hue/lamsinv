# =================================================================
# Environment Configuration Template
# Copy this to .env and fill in your values
# =================================================================

# Server Port
PORT=5000

# Supabase Credentials
VITE_SUPABASE_URL=https://iahytcrmstlkvnmwfxgs.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://iahytcrmstlkvnmwfxgs.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key

# Public server URL used by the authenticated Telegram webhook setup endpoint
PUBLIC_APP_URL=https://lamspower.pro.bd
CORS_ORIGINS=https://lamspower.pro.bd,https://www.lamspower.pro.bd,http://localhost:5173,http://127.0.0.1:5173

# Redis Cache URL (Optional: server runs in fallback mode if not active)
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------
# 1. Create a bot on Telegram with @BotFather to get your token
# 2. Get your target Chat ID, Channel ID, or Group ID (e.g., from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=generate_a_random_secret_at_least_32_characters_long

# -----------------------------------------------------------------
# Meta WhatsApp Cloud API (Graph API) Configuration
# -----------------------------------------------------------------
# 1. Meta for Developers Portal -> WhatsApp -> API Setup
# 2. Access Token with whatsapp_business_messaging permission
# 3. Phone Number ID from API Setup
# 4. Default recipient phone number with country code (e.g., 8801712345678)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_RECIPIENT=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Comma-separated WhatsApp sender numbers allowed to query inventory (country code, digits only)
WA_STOCK_ALLOWED_NUMBERS=
