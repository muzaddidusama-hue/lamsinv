# =================================================================
# Environment Configuration Template
# Copy this to .env and fill in your values
# =================================================================

# Server Port
PORT=5000

# Supabase Credentials
VITE_SUPABASE_URL=https://iahytcrmstlkvnmwfxgs.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini AI API Key
VITE_GEMINI_API_KEY=your_gemini_api_key

# Redis Cache URL (Optional: server runs in fallback mode if not active)
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------
# 1. Create a bot on Telegram with @BotFather to get your token
# 2. Get your target Chat ID, Channel ID, or Group ID (e.g., from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------
# Meta WhatsApp Cloud API (Graph API) Configuration
# -----------------------------------------------------------------
# 1. Meta for Developers Portal -> WhatsApp -> API Setup
# 2. Access Token with whatsapp_business_messaging permission
# 3. Phone Number ID from API Setup
# 4. Default recipient phone number with country code (e.g., 8801712345678)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_RECIPIENT=
